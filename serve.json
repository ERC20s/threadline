{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/product/:id", "destination": "/product.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/lookbook", "destination": "/lookbook.html" },
    { "source": "/size-guide", "destination": "/size-guide.html" }
  ]
}
