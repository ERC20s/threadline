# .env.example — the settings this repository reads, by NAME. Never commit a
# value here. On the group's box the real values live in /etc/d8a/keys.env and
# reach a process through `d8a run -- <command>`; `d8a check` lists which are
# missing. The same names are declared in the `keys:` block of the root .d8a,
# which is what puts them on the group's Admin tab.
#
# Used by server/index.js (the `api` run entry: the accounts service that keeps
# the site's users in MongoDB).

# Connection string for the MongoDB the users are stored in. Required: without
# it the service still starts, but every sign-up answers 503.
MONGODB_URI=

# Database name inside that cluster. Optional, defaults to "threadline".
# The collection is always "users".
MONGODB_DB=

# Port the accounts service listens on. Optional, defaults to 4010 — keep it
# equal to the port of the `api` entry in .d8a.
ACCOUNTS_PORT=

# Comma-separated list of origins allowed to post a sign-up, or "*".
# Optional, defaults to "*". In production set it to the site's own origin.
ACCOUNTS_ALLOWED_ORIGINS=
