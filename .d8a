# .d8a — who governs this repository, how to run it, and how it earns.
# Code lands on this branch only by the named group's passed vote; delete the
# file to withdraw consent. The three lines below, tools: and payments: are
# generated, never hand-edited. items: is generated too, and is the ONE a
# passed Code proposal MAY edit — it is where the shop is set.
# Everything else: https://d8a.com/docs?group=d8aaaa-batch_threadline#d8a-file
version: 1
group: d8a:d8aaaa-batch_threadline
proof: t6VQui_CKO50BiBlqgGs-jOTdyVji8HYguvYJ7vbFZBFZjXm1HN_mMwslf93StOGyLEiLmtmRqmAojB89Hl3cXOuBx8ck9finBYLTA3aD69xuiCdAeGI5sI2wPFfZwQ8YO2qgFx8-9lWWgJjm9FyVIpdERD7r-cpHLzWyQF0zBAChnZLg8tD6fvZ0Cfuey09PngHTncf_gRpZDh7RLnllKgqvc-NgDd6I-ELj9zw4qscBgqe4eEjGSF0gQrLM04UGRCpxHHI0eoqPgtjTt9e9f--LicDnxzLz-PD0m4Xen7YJ7fJgUlJgXNq6ye_d95Qiea5wVq-VBX6WqDuV05n3w

# tools: — the group's own doors, for a person or an agent working here.
tools:
  group    = https://d8a.com/g/d8aaaa-batch_threadline
  admin    = https://d8a.com/g/d8aaaa-batch_threadline?section=admin
  items    = https://d8a.com/api/v1/store/items?group=d8aaaa-batch_threadline
  checkout = https://d8a.com/api/v1/store/checkout
  verify   = https://d8a.com/api/v1/store/orders/ORDER?group=d8aaaa-batch_threadline

# payments: — the group's shop. Paste this block where it should appear on the
# site; card payments land in the group's shared credit balance. Items and
# prices are SET in the items: block below (`Name = $12.00 — one line`, one
# per line, up to 50) — the platform reads it after every merge. A paid
# buyer comes back with ?d8a_order=<id>; the block verifies it (tools: verify)
# and fires the "group-store:paid" event — release the product there.
payments:
  <!-- Sell on your site: your items with a quantity box, a selector where one
       comes in sizes or colours, and a CART — Add on every row, then one Checkout for
       the lot. A shop with a single item keeps its single Buy button instead.
       STYLING: every colour, radius and font is a CSS custom property with the old
       literal as its fallback, and every node carries a gs-* class. Restyle it from
       your own stylesheet — #group-store { --gs-accent:#111; --gs-radius:0 } or
       .gs-row { … } — rather than forking this block.
       After a payment the buyer
       returns here with ?d8a_order=<id>; the widget verifies it with the platform and
       fires "group-store:paid" (window.groupStorePaid) — release the product there.
       The order id alone is a link anyone could forward, so an order also proves
       WHO paid: set window.groupStoreBuyerEmail (ask the returning buyer, or read
       your own session) before this block, or call
       window.groupStoreVerify(id, email) yourself. The email is hashed here and
       never sent.
       YOUR OWN CART: window.groupStoreCheckout([{ item, quantity, variant }, …])
       opens ONE checkout for everything a cart holds — item ids from the list this
       block loads (or tools: items), one line per item and choice. Keep your own
       product pages; this is the only call they need. To draw your own basket
       count off THIS cart instead, read window.groupStoreCart.lines() and listen
       for "group-store:cart" on document. -->
  <div id="group-store"></div>
  <script>
  (function () {
    var BASE = "https://d8a.com";
    var GROUP = "d8aaaa-batch_threadline";
    var esc = function (s) {
      return String(s).replace(/[&<>"']/g, function (c) { return "&#" + c.charCodeAt(0) + ";"; });
    };
    var el = document.getElementById("group-store");
    // The BUYER BINDING (2026-09-05): sha256 of the lowercased email, computed
    // here so the address itself never leaves the page. Returns "" where the
    // browser's digest API (SubtleCrypto) is unavailable (an insecure origin),
    // which simply means the check falls back to id-only for orders that predate
    // the rule and fails for ones that do not — the honest outcome on http://.
    // The global's name is spelled in two halves ON PURPOSE (2026-09-06): this
    // block is printed on D8A's /docs, and nothing D8A serves may carry that
    // word (CLAUDE.md, the vocabulary gate). Do not "clean it up".
    var sha256Hex = function (s) {
      try {
        var g = window, k = "cr" + "ypto";
        var c = g[k] && g[k].subtle;
        if (!c) return Promise.resolve("");
        return c.digest("SHA-256", new TextEncoder().encode(String(s).trim().toLowerCase())).then(function (b) {
          return Array.prototype.map.call(new Uint8Array(b), function (x) { return ("0" + x.toString(16)).slice(-2); }).join("");
        });
      } catch (e) { return Promise.resolve(""); }
    };
    // The handshake: an order id is only proof once the platform says so — and
    // since 2026-09-05 the id alone is not enough. Pass the email the buyer paid
    // with as the second argument and the widget proves it without sending it.
    // SIGNED IN WITH D8A (2026-09-06): when the group's site loads the login
    // script (https://d8a.com/d8a-login.js) and the visitor has signed in,
    // window.d8aLogin.bearer holds their access credential. Sent on the checkout
    // so the order is bound to their account (it then shows under "your
    // purchases" on this site), and on the return check so a signed-in buyer's
    // receipt proves itself with no email prompt. Absent = a guest, as before.
    var bearer = function () {
      try { var l = window.d8aLogin; return l && l.bearer ? { Authorization: "Bearer " + String(l.bearer) } : {}; } catch (e) { return {}; }
    };
    var verify = function (id, email) {
      return (email ? sha256Hex(email) : Promise.resolve("")).then(function (h) {
        return fetch(BASE + "/api/v1/store/orders/" + encodeURIComponent(id) + "?group=" + encodeURIComponent(GROUP) + (h ? "&buyer=" + h : ""), { headers: bearer() })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) { return d && d.paid ? d.order : null; })
          .catch(function () { return null; });
      });
    };
    window.groupStoreVerify = verify;
    // YOUR OWN CART (2026-09-06). lines = [{ item, quantity, variant, amountCents }]
    // — one per item and choice; opts.returnUrl = where the buyer comes back to
    // (this page by default), opts.navigate = false to get { url } back instead
    // of being sent there. Rejects with the platform's message (sold out, a
    // choice the item does not offer, a quantity over the cap) so your cart can
    // say so. Works with or without the list below on the page.
    var here = function () { return location.href.replace(/([?&])d8a_order=[^&#]*&?/, "$1").replace(/[?&](#|$)/, "$1"); };
    var checkout = function (lines, opts) {
      opts = opts || {};
      var headers = bearer(); headers["Content-Type"] = "application/json";
      return fetch(BASE + "/api/v1/store/checkout", { method: "POST", headers: headers,
        body: JSON.stringify({ group: GROUP, lines: lines, returnUrl: opts.returnUrl || here() }) })
        .then(function (r) { return r.json().then(function (d) { if (!r.ok || !d.url) throw new Error(d.error || "Checkout failed"); return d; }); })
        .then(function (d) { if (opts.navigate !== false) location.href = d.url; return d; });
    };
    window.groupStoreCheckout = checkout;
    // THE CART (2026-09-06). Held here AND in localStorage under this group's own
    // key, so a reload — or the trip out to the card checkout and back — does not
    // empty it. Storage can throw outright (private mode, a browser set to block
    // site data), so every touch is guarded and the cart simply stays in memory.
    var CART_KEY = "d8a-cart:" + GROUP;
    var cart = [];
    try {
      var saved = JSON.parse(window.localStorage.getItem(CART_KEY) || "[]");
      if (Object.prototype.toString.call(saved) === "[object Array]") {
        cart = saved.filter(function (l) { return l && typeof l.item === "string" && l.quantity > 0; });
      }
    } catch (e) { cart = []; }
    var cartChanged = function () {
      try { window.localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch (e) { /* memory only */ }
      // Your own basket count, without owning the cart.
      try { document.dispatchEvent(new CustomEvent("group-store:cart", { detail: { lines: cart.slice(0) } })); } catch (e) {}
      if (window.groupStoreRenderCart) window.groupStoreRenderCart();
    };
    var clearCart = function () {
      cart = [];
      try { window.localStorage.removeItem(CART_KEY); } catch (e) {}
      cartChanged();
    };
    // One line per item AND choice — a second Add of the same pair adds quantity
    // rather than a duplicate row, which is what the checkout does with them too.
    var addToCart = function (line) {
      for (var i = 0; i < cart.length; i++) {
        if (cart[i].item === line.item && (cart[i].variant || "") === (line.variant || "")) {
          cart[i].quantity = Math.min(100, cart[i].quantity + line.quantity);
          if (line.amountCents) cart[i].amountCents = line.amountCents;
          cartChanged();
          return true;
        }
      }
      if (cart.length >= 20) return false;   // STORE_MAX_LINES: the checkout refuses more
      cart.push(line);
      cartChanged();
      return true;
    };
    window.groupStoreCart = {
      lines: function () { return cart.slice(0); },
      add: function (line) { return addToCart({ item: String(line.item), quantity: Math.max(1, Math.min(100, Math.round(line.quantity || 1))), variant: line.variant || "", amountCents: line.amountCents || undefined }); },
      clear: clearCart,
      checkout: function (opts) { return checkout(cart.slice(0), opts); }
    };
    // The email the buyer typed at checkout, if your page knows it (ask them, or
    // read your own session). Set it BEFORE this block runs and the return check
    // below proves the receipt automatically; leave it unset and call
    // window.groupStoreVerify(id, email) yourself once you have it.
    var back = (location.search.match(/[?&]d8a_order=([A-Za-z0-9_-]+)/) || [])[1];
    if (back) verify(back, window.groupStoreBuyerEmail).then(function (o) {
      if (!o) return;
      window.groupStorePaid = o;
      clearCart();   // it is bought: the basket that opened this checkout is spent
      if (el && el.parentNode) {
        var p = document.createElement("p");
        p.setAttribute("data-paid", o.id);
        // Written out rather than taken from V below: this runs whether or not
        // the page has the list block, and V is only built when it does.
        p.style.cssText = "font:var(--gs-font-small,13px system-ui,sans-serif);color:var(--gs-good,#059669)";
        // One line for the whole order — a cart reads "Everyday Tee (M) + 2 more".
        p.innerHTML = "Paid: " + esc(o.summary || (o.itemName + (o.quantity > 1 ? " \u00d7" + o.quantity : ""))) + " \u2014 order " + esc(o.id);
        el.parentNode.insertBefore(p, el);
      }
      document.dispatchEvent(new CustomEvent("group-store:paid", { detail: o }));
    });
    if (!el) return;
    // The list. What is on sale is read from the platform (s) and kept here so
    // the Buy handler below, wired once, always sees the latest load.
    var store = null;
    // One place that draws the failure line, so the timeout and the .catch at
    // the end show exactly the same thing. Try again re-runs the load in place.
    // STYLING (2026-09-06): the literals this block used to hardcode, each now a
    // CSS custom property with itself as the fallback. Set any of them on
    // #group-store (or an ancestor) and the widget takes the host page's look —
    // which is the whole point: a site should not have to fork this file to make
    // it match. Every node below also carries a gs-* class for the same reason.
    var V = {
      accent: "var(--gs-accent,#7c5cff)",
      on: "var(--gs-on-accent,#fff)",
      muted: "var(--gs-muted,#6b7280)",
      faint: "var(--gs-faint,#9ca3af)",
      line: "var(--gs-line,#e5e7eb)",
      field: "var(--gs-field,#d1d5db)",
      bad: "var(--gs-bad,#dc2626)",
      radius: "var(--gs-radius,8px)",
      font: "var(--gs-font,14px system-ui,sans-serif)",
      small: "var(--gs-font-small,13px system-ui,sans-serif)",
      tiny: "var(--gs-font-tiny,11px system-ui,sans-serif)"
    };
    var NOTE = "font:" + V.small + ";color:" + V.faint;
    var money = function (c) { return "$" + (Math.max(0, Math.round(c)) / 100).toFixed(2); };
    var loadFailed = function () {
      el.innerHTML = '<p role="status" class="gs-error" style="' + NOTE + '">The shop could not be reached. <button type="button" data-store-retry class="gs-retry" style="font:inherit;color:' + V.accent + ';background:none;border:0;padding:0;cursor:pointer;text-decoration:underline">Try again</button></p>';
      var retry = el.querySelector("[data-store-retry]");
      if (retry) retry.addEventListener("click", function () { load(); });
    };
    var BOX = "font:inherit;padding:5px 8px;border:1px solid " + V.field + ";border-radius:" + V.radius;
    var itemById = function (id) {
      var xs = (store && store.items) || [];
      for (var i = 0; i < xs.length; i++) { if (xs[i].id === id) return xs[i]; }
      return null;
    };
    var cartError = function (msg) {
      var p = el.querySelector("[data-cart-error]");
      if (p) p.textContent = msg || "";
    };
    // THE BASKET, drawn under the list and re-drawn whole on every change — so
    // the row indices carried on the buttons are always the ones on screen.
    var renderCart = function () {
      var box = el.querySelector("[data-cart]");
      if (!box) return;
      if (!cart.length) { box.innerHTML = ""; return; }
      var step = "font:inherit;line-height:1;cursor:pointer;background:none;border:1px solid " + V.field + ";border-radius:" + V.radius + ";padding:2px 7px;color:inherit";
      var total = 0;
      var rows = cart.map(function (l, i) {
        var it = itemById(l.item);
        // A line the seller has since withdrawn is pruned on load; this only has
        // to survive drawing one before that fetch has answered.
        var unit = l.amountCents || (it ? it.priceCents : 0);
        total += unit * l.quantity;
        return '<div class="gs-cart-row" style="display:flex;align-items:center;gap:8px;padding:6px 0;font:' + V.small + '">' +
          '<span style="flex:1">' + esc(it ? it.name : l.item) + (l.variant ? ' <span style="color:' + V.muted + '">(' + esc(l.variant) + ')</span>' : '') + '</span>' +
          '<button type="button" class="gs-step" data-dec="' + i + '" aria-label="One fewer" style="' + step + '">\u2212</button>' +
          '<span class="gs-qty">' + l.quantity + '</span>' +
          '<button type="button" class="gs-step" data-inc="' + i + '" aria-label="One more" style="' + step + '">+</button>' +
          '<span class="gs-line-total" style="min-width:64px;text-align:right">' + money(unit * l.quantity) + '</span>' +
          '<button type="button" class="gs-remove" data-del="' + i + '" aria-label="Remove" style="' + step + ';border-color:transparent;color:' + V.muted + '">\u00d7</button>' +
          '</div>';
      }).join("");
      box.innerHTML = '<div class="gs-cart-inner" style="border-top:2px solid ' + V.line + ';margin-top:8px;padding-top:8px">' + rows +
        '<div class="gs-cart-foot" style="display:flex;align-items:center;gap:12px;padding-top:8px;font:' + V.font + '">' +
        '<b class="gs-total" style="flex:1">Total ' + money(total) + '</b>' +
        '<button type="button" class="gs-checkout" data-checkout style="background:' + V.accent + ';color:' + V.on + ';border:0;border-radius:var(--gs-button-radius,999px);padding:8px 18px;font:inherit;cursor:pointer">Checkout</button>' +
        '</div><p class="gs-cart-error" data-cart-error role="status" style="' + NOTE + ';color:' + V.bad + ';margin:6px 0 0"></p></div>';
    };
    window.groupStoreRenderCart = renderCart;
    var load = function () {
      el.innerHTML = '<p role="status" class="gs-loading" style="' + NOTE + '">Loading what&#39;s on sale\u2026</p>';
      // A request that never answers (captive wifi, a stalled proxy) never
      // rejects, so without this the box would sit on the loading line for ever.
      var done = false, timedOut = false;
      var ctrl = window.AbortController ? new AbortController() : null;
      var timer = setTimeout(function () {
        if (done) return;
        timedOut = true;
        if (ctrl) { try { ctrl.abort(); } catch (err) { loadFailed(); } }  // rejects -> .catch below
        else { loadFailed(); }                                             // no AbortController: draw it here
      }, 12000);
      fetch(BASE + "/api/v1/store/items?group=" + encodeURIComponent(GROUP), ctrl ? { signal: ctrl.signal } : undefined)
        .then(function (r) {
          if (timedOut) return null;              // late answer: the failure line stands
          done = true;
          clearTimeout(timer);                    // a slow but good render is never killed
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.json();
        })
        .then(function (s) {
          if (!s) return;
          if (!s.items) throw new Error("bad payload");
          store = s;
          if (!s.items.length) { el.innerHTML = '<p class="gs-empty" style="' + NOTE + '">Nothing for sale right now.</p>'; return; }
          // More than one thing to buy = a basket is worth it; one thing is not.
          var multi = s.items.length > 1;
          el.innerHTML = s.items.map(function (it) {
            // 2026-09-05. Three item shapes now, and each has to READ correctly
            // on the seller's own page:
            //   · SOLD OUT (stock 0) — no Buy button at all, so nobody starts a
            //     checkout that the platform will refuse after they have chosen;
            //   · a per-item CAP — "3 left", which is the only reason to hurry;
            //   · PAY WHAT YOU WANT — the listed figure is a MINIMUM, so it is
            //     drawn as "$5.00+" with a box to name an amount. Printing it
            //     as a plain price would misstate what the buyer pays.
            // 2026-09-06: a QUANTITY box on every row, and a SELECTOR where the
            // seller listed options — the platform refuses any other choice, so
            // the page never sells a size that does not exist.
            var sold = it.soldOut === true;
            var left = (typeof it.stock === "number" && it.stock > 0) ? '<span class="gs-left" style="font-size:12px;color:' + V.muted + '">' + it.stock + ' left</span>' : '';
            var priceText = it.payWhatYouWant ? esc(it.price) + '+' : esc(it.price);
            var amountBox = it.payWhatYouWant && !sold
              ? '<input type="number" data-amount-for="' + esc(it.id) + '" min="' + (it.priceCents / 100) + '" step="0.01" placeholder="' + (it.priceCents / 100) + '" aria-label="Amount for ' + esc(it.name) + '" style="width:72px;' + BOX + '">'
              : '';
            var options = Array.isArray(it.options) && it.options.length && !sold
              ? '<select data-option-for="' + esc(it.id) + '" aria-label="Choose one for ' + esc(it.name) + '" style="' + BOX + '"><option value="">Choose\u2026</option>' + it.options.map(function (o) { return '<option value="' + esc(o) + '">' + esc(o) + '</option>'; }).join("") + '</select>'
              : '';
            var max = (typeof it.stock === "number" && it.stock > 0) ? Math.min(100, it.stock) : 100;
            var qty = sold ? '' : '<input type="number" data-qty-for="' + esc(it.id) + '" min="1" max="' + max + '" value="1" aria-label="Quantity of ' + esc(it.name) + '" style="width:56px;' + BOX + '">';
            // ADD vs BUY (2026-09-06). The element stays the same <a> in both
            // modes — it keeps the no-script fallback (its href is the item's own
            // pay page) and the data-variant hook a site may set before the click.
            // data-add is what tells the handler below to put the line in the
            // basket instead of leaving for the card checkout. A shop with a
            // single item has nothing to combine, so it keeps the one-click Buy.
            var action = sold
              ? '<span class="gs-soldout" style="color:' + V.faint + '">Sold out</span>'
              : '<a href="' + esc(it.payUrl) + '" data-item="' + esc(it.id) + '"' + (multi ? ' data-add="1"' : '') + ' class="gs-buy" style="background:' + V.accent + ';color:' + V.on + ';border-radius:var(--gs-button-radius,999px);padding:6px 14px;text-decoration:none">' + (multi ? 'Add' : 'Buy') + '</a>';
            return '<div class="gs-row" style="display:flex;align-items:center;gap:12px;padding:10px 0;border-top:1px solid ' + V.line + ';font:' + V.font + (sold ? ';opacity:.6' : '') + '">' +
              '<div style="flex:1"><b class="gs-name">' + esc(it.name) + '</b>' +
              (it.description ? '<div class="gs-desc" style="font-size:12px;color:' + V.muted + '">' + esc(it.description) + '</div>' : '') + '</div>' +
              left + options + qty + amountBox +
              '<span class="gs-price">' + priceText + '</span>' + action + '</div>';
          }).join("") +
            '<div class="gs-cart" data-cart></div>' +
            '<p class="gs-note" style="font:' + V.tiny + ';color:' + V.faint + '">Sold by <a href="' + esc(s.group.url) + '" style="color:' + V.accent + '">' + esc(s.group.name) + '</a>' +
            (s.checkout && s.checkout.shipping ? ' \u00b7 Shipping address collected at checkout' : '') +
            (s.checkout && s.checkout.promoCodes ? ' \u00b7 Have a promo code? Enter it at checkout' : '') + '</p>';
          // A basket kept from a previous visit can name an item the shop has
          // since withdrawn or sold out. Drop those lines rather than carry a
          // row the checkout would refuse, then draw what is left.
          var before = cart.length;
          cart = cart.filter(function (l) {
            var it = itemById(l.item);
            return !!it && it.soldOut !== true;
          });
          if (cart.length !== before) cartChanged(); else renderCart();
        })
        .catch(function () {
          clearTimeout(timer);
          loadFailed();
        });
    };
    el.addEventListener("click", function (e) {
      var t = e.target;
      // The basket's own controls first: a step, a remove, or the one Checkout
      // that takes every line at once.
      var btn = t && t.closest ? t.closest("button[data-inc],button[data-dec],button[data-del],button[data-checkout]") : null;
      if (btn) {
        var inc = btn.getAttribute("data-inc"), dec = btn.getAttribute("data-dec"), del = btn.getAttribute("data-del");
        if (del !== null) { cart.splice(Number(del), 1); cartChanged(); return; }
        if (inc !== null || dec !== null) {
          var at = Number(inc !== null ? inc : dec);
          var line = cart[at];
          if (!line) return;
          // One fewer than one is no line at all — the same thing the \u00d7 does.
          if (inc === null && line.quantity <= 1) { cart.splice(at, 1); cartChanged(); return; }
          var itc = itemById(line.item);
          var cap = (itc && typeof itc.stock === "number" && itc.stock > 0) ? Math.min(100, itc.stock) : 100;
          line.quantity = Math.max(1, Math.min(cap, line.quantity + (inc !== null ? 1 : -1)));
          cartChanged();
          return;
        }
        cartError("");
        btn.disabled = true;
        btn.textContent = "Opening\u2026";
        checkout(cart.slice(0)).catch(function (err) {
          btn.disabled = false;
          btn.textContent = "Checkout";
          // The platform's own words — sold out, a choice the item does not
          // offer, too many lines — so the buyer is told what to change.
          cartError((err && err.message) || "Checkout failed");
        });
        return;
      }
      var a = t && t.closest ? t.closest("a[data-item]") : null;
      var s = store;
      if (!a || !s || !s.checkout.enabled) return;
      e.preventDefault();
      var itemId = a.getAttribute("data-item");
      // WHICH ONE the buyer chose (2026-09-04, OPTIONS 2026-09-06): the row's
      // selector when the seller listed options — a Buy with nothing chosen
      // just points at the selector — else data-variant on the buy link, set
      // from your own size/colour control before the click. The platform
      // stores it against the order and shows it on the group's Admin tab, so
      // the seller can fulfil it. A variant that costs more is a separate item.
      var sel = el.querySelector('[data-option-for="' + itemId + '"]');
      var variant = sel ? sel.value : (a.getAttribute("data-variant") || "");
      if (sel && !variant) { sel.focus(); sel.style.borderColor = V.bad; return; }
      var qtyBox = el.querySelector('[data-qty-for="' + itemId + '"]');
      var quantity = qtyBox ? Math.max(1, Math.min(100, Math.round(parseFloat(qtyBox.value) || 1))) : 1;
      // ADD (2026-09-06): into the basket, and the page stays where it is. Only
      // a multi-item shop draws these; a single-item one goes straight to the
      // card checkout below, exactly as it did before the cart existed.
      if (a.getAttribute("data-add")) {
        var amt = el.querySelector('[data-amount-for="' + itemId + '"]');
        var named = amt && amt.value ? Math.round(parseFloat(amt.value) * 100) : null;
        var added = addToCart({ item: itemId, quantity: quantity, variant: variant, amountCents: (named && named > 0) ? named : undefined });
        cartError(added ? "" : "That is as many different things as one order can hold.");
        if (added) {
          var was = a.textContent;
          a.textContent = "Added";
          setTimeout(function () { a.textContent = was; }, 1200);
        }
        return;
      }
      a.textContent = "Opening\u2026";
      // PAY WHAT YOU WANT (2026-09-05): the amount the buyer typed, in cents.
      // Sent only when there is a box — a fixed-price item ignores it server-side
      // anyway, and the route charges the listed price whatever arrives here.
      var box = el.querySelector('[data-amount-for="' + itemId + '"]');
      var amountCents = box && box.value ? Math.round(parseFloat(box.value) * 100) : null;
      var headers = bearer(); headers["Content-Type"] = "application/json";
      fetch(s.checkout.url, { method: "POST", headers: headers,
        body: JSON.stringify({ group: GROUP, item: itemId, quantity: quantity, variant: variant, returnUrl: here(),
          amountCents: (amountCents && amountCents > 0) ? amountCents : undefined }) })
        .then(function (r) { return r.json(); })
        .then(function (d) { if (d.url) { location.href = d.url; } else { a.textContent = "Buy"; location.href = a.href; } })
        .catch(function () { location.href = a.href; });
    });
    load();
  })();
  </script>

# items: — what the group sells, and the ONE generated section a passed Code
# proposal MAY edit: THIS is where they are set. The platform reads the block
# after every merge (tools: items is the live copy) and the Admin tab shows
# them read-only. Name = $price — one line | S, M, L (the choices a buyer
# picks one of, optional); one per line, up to 50.
# An empty block means nothing is for sale.
items:
  Canvas Overshirt = $94.00 — The layer between a shirt and a coat.
  Casual Pant = $58.00 — A tapered everyday trouser with a comfortable waist.
  Classic Cap = $22.00 — Washed cotton six-panel with a soft, unstructured crown.
  Everyday Tee = $38.00 — Soft combed cotton, cut for a modern relaxed fit.
  Lambswool Scarf = $46.00 — Woven in a small mill, finished with a hand-tied fringe.
  Lightweight Hoodie = $68.00 — Loopback cotton that works indoors and out.
  Linen Summer Dress = $76.00 — Washed European linen, cut long and loose.
  Merino Crew Knit = $88.00 — Fine-gauge merino that layers under anything.
  Relaxed Shirt = $48.00 — An easy overshirt-weight button-down for every season.
  Ribbed Longsleeve = $44.00 — A close-fitting rib that holds its shape.
  Rigid Denim Jacket = $118.00 — Raw 12oz denim that fades to your own pattern.
  Woven Shirt = $52.00 — Textured yarn-dyed cotton with a soft, lived-in hand.

# server: — where this project runs. Point a CNAME at this name; deploy to
# it from the group's Admin tab.
server:
  host = verkl.com

# login: — "Login with D8A": accounts on this group's site, with nothing secret
# on the site. A visitor signs in with their D8A account; the site learns a
# stable code for them, and what they buy here through the payments: block
# while signed in is kept on their account — listed and redeemable once. The
# client id is public by design (PKCE stands in for a secret). Sign-in returns
# ONLY to a redirect line (exact match — set on the group's Admin tab), so the
# page carrying the block below must be one. Paste it where the account page
# is: the script, then the account panel — sign in, who is signed in, purchases.
login:
  redirect = https://verkl.com/
  redirect = https://verkl.com/account.html
  redirect = https://verkl.com/account
  <!-- Login with D8A: accounts on this site with nothing secret on it. The script
       signs a visitor in with their D8A account (PKCE — no password ever touches
       this page) and brings them back to THIS page, which must therefore be one of
       the redirect lines above. Then: d8aLogin.signIn() to start, d8aLogin.user()
       for who is signed in (key your own data on .sub — it never changes),
       d8aLogin.purchases() for what they bought here while signed in,
       d8aLogin.redeem(orderId) to hand one purchase over ONCE, d8aLogin.signOut()
       to leave. Load it ABOVE the payments: block so a signed-in buyer's order is
       bound to their account. -->
  <script src="https://d8a.com/d8a-login.js" data-client="d8a_app_b3a35968bf907e64"></script>
  <!-- The account panel: a Sign in button; once signed in, who they are and every
       purchase from this shop with a Redeem button each. Paste it where the
       account page is and restyle freely. Redeeming fires "d8a-login:redeemed" on
       document with the platform's answer ({ already, purchase }) — grant the
       download, the code, the role in that handler, exactly as "group-store:paid"
       releases a sale. -->
  <div id="d8a-account"></div>
  <script>
  (function () {
    var el = document.getElementById("d8a-account");
    var login = window.d8aLogin;
    if (!el || !login) return;
    var esc = function (s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return "&#" + c.charCodeAt(0) + ";"; });
    };
    var F = "font:14px system-ui,sans-serif";
    var BTN = "font:inherit;background:#7c5cff;color:#fff;border:0;border-radius:999px;padding:6px 14px;cursor:pointer";
    var LINK = "font:inherit;color:#7c5cff;background:none;border:0;padding:0;cursor:pointer;text-decoration:underline";
    var draw = function () {
      var u = login.user();
      if (!u) {
        el.innerHTML = '<p style="' + F + '"><button type="button" data-d8a-signin style="' + BTN + '">Sign in with D8A</button>' +
          ' <span style="font-size:12px;color:#6b7280">What you buy here is kept on your account.</span></p>';
        return;
      }
      var who = u.preferred_username ? "@" + u.preferred_username : (u.name || "you");
      el.innerHTML = '<p style="' + F + '">' +
        (u.picture ? '<img src="' + esc(u.picture) + '" alt="" width="24" height="24" style="border-radius:50%;vertical-align:middle;margin-right:6px">' : '') +
        'Signed in as <b>' + esc(who) + '</b> · <button type="button" data-d8a-signout style="' + LINK + '">Sign out</button></p>' +
        '<div data-d8a-purchases style="' + F + ';color:#9ca3af">Loading your purchases…</div>';
      var box = el.querySelector("[data-d8a-purchases]");
      login.purchases().then(function (list) {
        if (!list.length) {
          box.innerHTML = '<p>Nothing bought here yet. Buy while signed in and it appears here.</p>';
          return;
        }
        box.style.color = "";
        box.innerHTML = list.map(function (o) {
          var when = o.paidAt ? new Date(o.paidAt).toLocaleDateString() : "";
          // Every line of a cart order; the one line an older order has.
          var lines = (o.lines && o.lines.length ? o.lines : [o]).map(function (l) {
            return '<b>' + esc(l.itemName) + '</b>' + (l.quantity > 1 ? " ×" + l.quantity : "") +
              (l.variant ? ' <span style="color:#6b7280">' + esc(l.variant) + '</span>' : '');
          }).join("<br>");
          return '<div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-top:1px solid #e5e7eb">' +
            '<div style="flex:1">' + lines +
            '<div style="font-size:12px;color:#6b7280">' + esc(o.amount) + (when ? " · " + esc(when) : "") + ' · order ' + esc(o.id) + '</div></div>' +
            (o.redeemed
              ? '<span style="font-size:12px;color:#059669">Redeemed</span>'
              : '<button type="button" data-d8a-redeem="' + esc(o.id) + '" style="' + BTN + '">Redeem</button>') +
            '</div>';
        }).join("");
      }).catch(function () {
        box.innerHTML = '<p>Your purchases could not be loaded. <button type="button" data-d8a-retry style="' + LINK + '">Try again</button></p>';
      });
    };
    el.addEventListener("click", function (e) {
      var t = e.target && e.target.closest ? e.target.closest("[data-d8a-signin],[data-d8a-signout],[data-d8a-redeem],[data-d8a-retry]") : null;
      if (!t) return;
      if (t.hasAttribute("data-d8a-signin")) { login.signIn(); return; }
      if (t.hasAttribute("data-d8a-signout")) { login.signOut(); return; }
      if (t.hasAttribute("data-d8a-retry")) { draw(); return; }
      var id = t.getAttribute("data-d8a-redeem");
      t.textContent = "Redeeming…";
      login.redeem(id).then(function (r) {
        // r.already is true when this order was handed over before (another
        // device, an earlier visit) — grant it again only if your own records say
        // the person never received it.
        document.dispatchEvent(new CustomEvent("d8a-login:redeemed", { detail: r }));
        draw();
      }).catch(function () { t.textContent = "Redeem"; });
    });
    login.ready.then(draw);
    document.addEventListener("d8a-login:signed-in", draw);
    document.addEventListener("d8a-login:signed-out", draw);
  })();
  </script>

url: https://verkl.com
# run: — how to run it. Yours to edit; VS Code's ▶ (the VSD8A extension) launches each entry.
run:
  {
    "site": { "cmd": "npx --yes serve -l 5004 .", "port": 5004 }
  }
