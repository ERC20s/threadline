# payments: — the group's shop. Paste this block where it should appear on the
# site; card payments land in the group's shared credit balance. Items and
# prices are SET in the items: block below (`Name = $12.00 — one line`, one
# per line, up to 50) — the platform reads it after every merge. A paid
# buyer comes back with ?d8a_order=<id>; the block verifies it (tools: verify)
# and fires the "group-store:paid" event — release the product there.
payments:
  <!-- Sell on your site: your items, a Buy button each. After a payment the buyer
       returns here with ?d8a_order=<id>; the widget verifies it with the platform and
       fires "group-store:paid" (window.groupStorePaid) — release the product there.
       The order id alone is a link anyone could forward, so an order also proves
       WHO paid: set window.groupStoreBuyerEmail (ask the returning buyer, or read
       your own session) before this block, or call
       window.groupStoreVerify(id, email) yourself. The email is hashed here and
       never sent. -->
  <div id="group-store"></div>
  <script>
  (function () {
    var BASE = "https://d8a.com";
    var GROUP = "d8aaaa-batch_threadline";
    var esc = function (s) {
      return String(s).replace(/[&<>"']/g, function (c) { return "&#" + c.charCodeAt(0) + ";"; });
    };
    var el = document.getElementById("group-store");
    // The BUYER BINDING (2026-09-05): sha256 of the lowercased email, computed
    // here so the address itself never leaves the page. Returns "" where
    // crypto.subtle is unavailable (an insecure origin), which simply means the
    // check falls back to id-only for orders that predate the rule and fails for
    // ones that do not — the honest outcome on http://.
    var sha256Hex = function (s) {
      try {
        var c = window.crypto && window.crypto.subtle;
        if (!c) return Promise.resolve("");
        return c.digest("SHA-256", new TextEncoder().encode(String(s).trim().toLowerCase())).then(function (b) {
          return Array.prototype.map.call(new Uint8Array(b), function (x) { return ("0" + x.toString(16)).slice(-2); }).join("");
        });
      } catch (e) { return Promise.resolve(""); }
    };
    // The handshake: an order id is only proof once the platform says so — and
    // since 2026-09-05 the id alone is not enough. Pass the email the buyer paid
    // with as the second argument and the widget proves it without sending it.
    var verify = function (id, email) {
      return (email ? sha256Hex(email) : Promise.resolve("")).then(function (h) {
        return fetch(BASE + "/api/v1/store/orders/" + encodeURIComponent(id) + "?group=" + encodeURIComponent(GROUP) + (h ? "&buyer=" + h : ""))
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) { return d && d.paid ? d.order : null; })
          .catch(function () { return null; });
      });
    };
    window.groupStoreVerify = verify;
    // The email the buyer typed at checkout, if your page knows it (ask them, or
    // read your own session). Set it BEFORE this block runs and the return check
    // below proves the receipt automatically; leave it unset and call
    // window.groupStoreVerify(id, email) yourself once you have it.
    var back = (location.search.match(/[?&]d8a_order=([A-Za-z0-9_-]+)/) || [])[1];
    if (back) verify(back, window.groupStoreBuyerEmail).then(function (o) {
      if (!o) return;
      window.groupStorePaid = o;
      if (el && el.parentNode) {
        var p = document.createElement("p");
        p.setAttribute("data-paid", o.id);
        p.style.cssText = "font:13px system-ui,sans-serif;color:#059669";
        p.innerHTML = "Paid: " + esc(o.itemName) + (o.quantity > 1 ? " \u00d7" + o.quantity : "") + " \u2014 order " + esc(o.id);
        el.parentNode.insertBefore(p, el);
      }
      document.dispatchEvent(new CustomEvent("group-store:paid", { detail: o }));
    });
    if (!el) return;
    // The list. What is on sale is read from the platform (s) and kept here so
    // the Buy handler below, wired once, always sees the latest load.
    var store = null;
    // One place that draws the failure line, so the timeout and the .catch at
    // the end show exactly the same thing. Try again re-runs the load in place.
    var loadFailed = function () {
      el.innerHTML = '<p role="status" style="font:13px system-ui,sans-serif;color:#9ca3af">The shop could not be reached. <button type="button" data-store-retry style="font:inherit;color:#7c5cff;background:none;border:0;padding:0;cursor:pointer;text-decoration:underline">Try again</button></p>';
      var retry = el.querySelector("[data-store-retry]");
      if (retry) retry.addEventListener("click", function () { load(); });
    };
    var load = function () {
      el.innerHTML = '<p role="status" style="font:13px system-ui,sans-serif;color:#9ca3af">Loading what&#39;s on sale\u2026</p>';
      // A request that never answers (captive wifi, a stalled proxy) never
      // rejects, so without this the box would sit on the loading line for ever.
      var done = false, timedOut = false;
      var ctrl = window.AbortController ? new AbortController() : null;
      var timer = setTimeout(function () {
        if (done) return;
        timedOut = true;
        if (ctrl) { try { ctrl.abort(); } catch (err) { loadFailed(); } }  // rejects -> .catch below
        else { loadFailed(); }                                             // no AbortController: draw it here
      }, 12000);
      fetch(BASE + "/api/v1/store/items?group=" + encodeURIComponent(GROUP), ctrl ? { signal: ctrl.signal } : undefined)
        .then(function (r) {
          if (timedOut) return null;              // late answer: the failure line stands
          done = true;
          clearTimeout(timer);                    // a slow but good render is never killed
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.json();
        })
        .then(function (s) {
          if (!s) return;
          if (!s.items) throw new Error("bad payload");
          store = s;
          if (!s.items.length) { el.innerHTML = '<p style="font:13px system-ui,sans-serif;color:#9ca3af">Nothing for sale right now.</p>'; return; }
          el.innerHTML = s.items.map(function (it) {
            // 2026-09-05. Three item shapes now, and each has to READ correctly
            // on the seller's own page:
            //   · SOLD OUT (stock 0) — no Buy button at all, so nobody starts a
            //     checkout that the platform will refuse after they have chosen;
            //   · a per-item CAP — "3 left", which is the only reason to hurry;
            //   · PAY WHAT YOU WANT — the listed figure is a MINIMUM, so it is
            //     drawn as "$5.00+" with a box to name an amount. Printing it
            //     as a plain price would misstate what the buyer pays.
            var sold = it.soldOut === true;
            var left = (typeof it.stock === "number" && it.stock > 0) ? '<span style="font-size:12px;color:#6b7280">' + it.stock + ' left</span>' : '';
            var priceText = it.payWhatYouWant ? esc(it.price) + '+' : esc(it.price);
            var amountBox = it.payWhatYouWant && !sold
              ? '<input type="number" data-amount-for="' + esc(it.id) + '" min="' + (it.priceCents / 100) + '" step="0.01" placeholder="' + (it.priceCents / 100) + '" aria-label="Amount for ' + esc(it.name) + '" style="width:72px;font:inherit;padding:5px 8px;border:1px solid #d1d5db;border-radius:8px">'
              : '';
            var action = sold
              ? '<span style="color:#9ca3af">Sold out</span>'
              : '<a href="' + esc(it.payUrl) + '" data-item="' + esc(it.id) + '" style="background:#7c5cff;color:#fff;border-radius:999px;padding:6px 14px;text-decoration:none">Buy</a>';
            return '<div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-top:1px solid #e5e7eb;font:14px system-ui,sans-serif' + (sold ? ';opacity:.6' : '') + '">' +
              '<div style="flex:1"><b>' + esc(it.name) + '</b>' +
              (it.description ? '<div style="font-size:12px;color:#6b7280">' + esc(it.description) + '</div>' : '') + '</div>' +
              left + amountBox +
              '<span>' + priceText + '</span>' + action + '</div>';
          }).join("") + '<p style="font:11px system-ui,sans-serif;color:#9ca3af">Sold by <a href="' + esc(s.group.url) + '" style="color:#7c5cff">' + esc(s.group.name) + '</a></p>';
        })
        .catch(function () {
          clearTimeout(timer);
          loadFailed();
        });
    };
    el.addEventListener("click", function (e) {
      var a = e.target && e.target.closest ? e.target.closest("a[data-item]") : null;
      var s = store;
      if (!a || !s || !s.checkout.enabled) return;
      e.preventDefault();
      a.textContent = "Opening\u2026";
      // Come back to this page — minus any earlier receipt on the URL.
      var here = location.href.replace(/([?&])d8a_order=[^&#]*&?/, "$1").replace(/[?&](#|$)/, "$1");
      // WHICH ONE the buyer chose (2026-09-04): put data-variant on the buy link
      // and set it from your own size/colour control before the click. The
      // platform stores it against the order and shows it on the group's Admin
      // tab, so the seller can fulfil it. One short line; a variant that costs
      // more is a separate item.
      var variant = a.getAttribute("data-variant") || "";
      // PAY WHAT YOU WANT (2026-09-05): the amount the buyer typed, in cents.
      // Sent only when there is a box — a fixed-price item ignores it server-side
      // anyway, and the route charges the listed price whatever arrives here.
      var itemId = a.getAttribute("data-item");
      var box = el.querySelector('[data-amount-for="' + itemId + '"]');
      var amountCents = box && box.value ? Math.round(parseFloat(box.value) * 100) : null;
      fetch(s.checkout.url, { method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ group: GROUP, item: itemId, quantity: 1, variant: variant, returnUrl: here,
          amountCents: (amountCents && amountCents > 0) ? amountCents : undefined }) })
        .then(function (r) { return r.json(); })
        .then(function (d) { if (d.url) { location.href = d.url; } else { a.textContent = "Buy"; location.href = a.href; } })
        .catch(function () { location.href = a.href; });
    });
    load();
  })();
  </script>

# items: — what the group sells, and the ONE generated section a passed Code
# proposal MAY edit: THIS is where they are set. The platform reads the block
# after every merge (tools: items is the live copy) and the Admin tab shows
# them read-only. Name = $price — one line, one per line, up to 50.
# An empty block means nothing is for sale.
items:
  Canvas Overshirt = $94.00 — The layer between a shirt and a coat.
  Casual Pant = $58.00 — A tapered everyday trouser with a comfortable waist.
  Classic Cap = $22.00 — Washed cotton six-panel with a soft, unstructured crown.
  Everyday Tee = $38.00 — Soft combed cotton, cut for a modern relaxed fit.
  Lambswool Scarf = $46.00 — Woven in a small mill, finished with a hand-tied fringe.
  Lightweight Hoodie = $68.00 — Loopback cotton that works indoors and out.
  Linen Summer Dress = $76.00 — Washed European linen, cut long and loose.
  Merino Crew Knit = $88.00 — Fine-gauge merino that layers under anything.
  Relaxed Shirt = $48.00 — An easy overshirt-weight button-down for every season.
  Ribbed Longsleeve = $44.00 — A close-fitting rib that holds its shape.
  Rigid Denim Jacket = $118.00 — Raw 12oz denim that fades to your own pattern.
  Woven Shirt = $52.00 — Textured yarn-dyed cotton with a soft, lived-in hand.

url: https://verkl.com
# run: — how to run it. Yours to edit; VS Code's ▶ (the VSD8A extension) launches each entry.
run:
  {
    "site": { "cmd": "npx --yes serve -l 5004 .", "port": 5004 }
  }
